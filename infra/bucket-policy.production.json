{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadFinalizedImagesOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::mailvender/dev/images/*/public/*",
        "arn:aws:s3:::mailvender/prod/images/*/public/*"
      ]
    }
  ]
}
