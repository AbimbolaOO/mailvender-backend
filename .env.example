# Mailvender API / worker configuration. Names only – never commit real values.
# Local development needs none of these: docker-compose.yml sets development values.
# docker-compose.prod.yml defaults the domain settings to mailvender.com; in
# production you only have to fill in DATABASE_URL, the secrets and (optionally) AWS.
# Step-by-step: docs/PRODUCTION_SETUP.md.

ENVIRONMENT=production
DATABASE_URL=

# Public URLs
APP_BASE_URL=                 # the Next.js app, e.g. https://www.mailvender.com
PUBLIC_API_BASE_URL=          # how recipients reach the API, e.g. https://www.mailvender.com/api
ALLOWED_ORIGINS=              # JSON list, e.g. ["https://www.mailvender.com"]
TRUST_FORWARDED_FOR=          # true behind the Next.js rewrite / a load balancer

# Secrets (from your secret store)
SECRET_KEY=                   # ≥32 random bytes: token hashing, signed unsubscribe links
DKIM_ENCRYPTION_KEY=          # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTERNAL_API_TOKEN=           # shared with Postfix for DSN delivery
FEEDBACK_LOOP_SECRETS=        # name:secret,name2:secret2 – HMAC secrets per complaint source

# Sessions
SESSION_COOKIE_SECURE=        # true (default) – keep it on outside local HTTP testing
SESSION_TTL_HOURS=

# Outbound MTA (Postfix with OpenDKIM)
SMTP_HOST=
SMTP_PORT=
SMTP_STARTTLS=
SYSTEM_FROM_EMAIL=            # e.g. Mailvender <no-reply@mailvender.com>
RETURN_PATH_SUBDOMAIN=        # default: bounce
RETURN_PATH_MX_HOST=          # the MX that receives bounces for return-path subdomains, e.g. feedback.mailvender.com
SPF_INCLUDE_DOMAIN=           # SPF record listing Mailvender's outbound IPs, e.g. _spf.mailvender.com
DKIM_KEYS_DIR=                # private volume shared with OpenDKIM (worker only)
DNS_NAMESERVERS=              # optional, comma-separated

# Postfix container (docker-compose.prod.yml sets the network, TLS paths and production mode)
POSTFIX_HOSTNAME=             # e.g. mail.mailvender.com; must match the IP's PTR record and the ./certs certificate
# Empty: deliver directly to recipients' MX (needs outbound port 25). Or a smarthost, e.g. [smtp.example.net]:587
POSTFIX_RELAYHOST=
POSTFIX_RELAYHOST_USERNAME=   # optional smarthost credentials (sent only over verified TLS)
POSTFIX_RELAYHOST_PASSWORD=
POSTFIX_SMTP_TLS_LEVEL=       # default: may (opportunistic); dane needs a DNSSEC-validating resolver
API_PUBLISH=                  # compose port binding for the API, default 127.0.0.1:8000

# Sending limits and account health (defaults in backend/app/config.py)
DEFAULT_HOURLY_RECIPIENT_LIMIT=
DEFAULT_DAILY_RECIPIENT_LIMIT=
HEALTH_WINDOW_DAYS=
HEALTH_MIN_VOLUME=
HEALTH_MAX_BOUNCE_RATE=
HEALTH_MAX_COMPLAINT_RATE=

# AWS S3 (images and dataset copies) – required by both compose files.
# The folder in the bucket is set by the compose file: docker-compose.yml uses
# dev/, docker-compose.prod.yml uses prod/. Bucket setup: docs/RUNBOOK.md.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=       # bucket URL, e.g. https://<bucket>.s3.<region>.amazonaws.com, or a CDN in front of it

# Next.js (frontend)
API_INTERNAL_URL=             # where the Next.js server reaches the API, e.g. http://api:8000
